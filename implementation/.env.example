# Copy this file to .env and change the values. Never commit the real .env file.
APP_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
# PostgreSQL connection (leave empty to use a local SQLite file)
DATABASE_URL=postgresql://disease:disease@db:5432/disease
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
# Set to 1 when the site is served over HTTPS
COOKIE_SECURE=0
LOG_LEVEL=INFO
